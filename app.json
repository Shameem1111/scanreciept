{
  "expo": {
    "name": "ReceiptMind",
    "slug": "scanreciept",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "receiptmind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.shameem.receiptmind",
      "usesIcloudStorage": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ReceiptMind uses the camera only when you choose to scan a receipt.",
        "NSPhotoLibraryUsageDescription": "ReceiptMind accesses your photo library only when you choose to upload a receipt.",
        "NSUbiquitousContainers": {
          "iCloud.com.shameem.receiptmind": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "ReceiptMind",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.shameem.receiptmind",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#164D35"
      }
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "ReceiptMind accesses your photos only when you choose a receipt image.",
          "cameraPermission": "ReceiptMind uses the camera only when you choose to scan a receipt.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": false,
          "enableFileSharing": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#164D35",
          "image": "./assets/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#164D35",
            "image": "./assets/splash-mark.png"
          }
        }
      ]
    ],
    "extra": {
      "receiptAiEndpoint": "",
      "appVariant": "development",
      "eas": {
        "projectId": "cbfbaab1-8013-4be8-a472-b86742db3667"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "shameem1189"
  }
}
