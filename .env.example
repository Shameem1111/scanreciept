# Public ReceiptMind Worker URL. This is not a secret and may be overridden per build.
# Do NOT put Gemini/OpenAI secret keys in Expo environment variables.
EXPO_PUBLIC_RECEIPT_AI_ENDPOINT=https://receiptmind-api.r7tg4t4tcc.workers.dev/receipt/extract

# Future storage integration values (OAuth client IDs are public identifiers, secrets stay server-side).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
