# Public ReceiptMind Worker URL. This is not a secret and may be overridden per build.
# Do NOT put Gemini/OpenAI secret keys in Expo environment variables.
EXPO_PUBLIC_RECEIPT_AI_ENDPOINT=https://receiptmind-api.r7tg4t4tcc.workers.dev/receipt/extract

# Public mobile OAuth client IDs from your Google Console project. Leave blank until configured.
# No client secret. Android ID gates setup; the native SDK uses package + signing SHA-1.
# iOS ID also generates its native URL scheme at build time. Drive requires a native build, not Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Public Web OAuth client ID, used as the receipt ID-token audience (not a secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public, owner-hosted HTTPS pages. Required for production; preview shows placeholders.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_DATA_DELETION_URL=
# Optional EAS project association and user-facing release version.
# EAS_PROJECT_ID=
# EXPO_OWNER=
# APP_VERSION=0.1.0
