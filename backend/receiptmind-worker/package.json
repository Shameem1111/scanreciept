{
  "name": "receiptmind-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types --env-interface CloudflareBindings --include-runtime false --strict-vars false"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
